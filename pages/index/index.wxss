/* 页面容器 */
.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7f6;
}

/* ===== 底部输入区 ===== */
.bottom-bar {
  flex-shrink: 0;
  z-index: 10;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 0 24rpx 20rpx;
}

.bottom-spacer {
  height: 20vh;
}

.todo-input {
  flex: 1;
  height: 72rpx;
  padding: 0 32rpx;
  background-color: #f0f2f1;
  border-radius: 36rpx;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #b0b8b3;
}

.add-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  margin-right: 20rpx;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #4CAF50;
  color: #fff;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
  border-radius: 50%;
}

.add-btn.disabled {
  background-color: #a5d6a7;
}

/* ===== 统计条 ===== */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx;
}

.stats-text {
  font-size: 26rpx;
  color: #8c9a90;
}


/* ===== 列表区 ===== */
.todo-list {
  flex: 1;
  padding: 0 28rpx 40rpx;
}

/* ===== 单条事项 ===== */
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.todo-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

/* 状态方块（普通项） */
.status-square {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background-color: #e57373;
  margin-right: 24rpx;
  transition: all 0.2s ease;
}

.status-square.done-square {
  background-color: #4CAF50;
}

/* 固定项图标 */
.pinned-icon {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

/* 文字区域 */
.todo-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.todo-text {
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.4;
}

/* 固定项蓝色文字 */
.todo-text.pinned-text {
  font-weight: 500;
}

/* 可爱字体 */
.todo-text.cute-font {
  font-weight: 600;
  letter-spacing: 2rpx;
}

.todo-progress {
  font-size: 24rpx;
  color: #8c9a90;
  margin-top: 6rpx;
}

/* 未完成提示 */
.unfinished-hint {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #e57373;
  margin-right: 8rpx;
  white-space: nowrap;
}

/* ===== 删除按钮 ===== */
.delete-btn {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-left: 12rpx;
}

.delete-icon {
  font-size: 30rpx;
  color: #d0d5d2;
  font-weight: 300;
}

.delete-btn:active {
  background-color: #fff0f0;
}

.delete-btn:active .delete-icon {
  color: #e57373;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8c9a90;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bcc5bf;
}
