/* 页面容器 */
.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7f6;
}

/* ===== 顶部输入区 ===== */
.input-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.todo-input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  background-color: #f0f2f1;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #333;
}

.placeholder {
  color: #b0b8b3;
}

.add-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  text-align: center;
  background-color: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  border: none;
}

.add-btn[disabled] {
  background-color: #c8e6c9;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 统计条 ===== */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx;
}

.stats-text {
  font-size: 26rpx;
  color: #8c9a90;
}

.stats-clear {
  font-size: 26rpx;
  color: #1976d2;
}

/* ===== 列表区 ===== */
.todo-list {
  flex: 1;
  padding: 0 28rpx 40rpx;
}

/* ===== 单条待办 ===== */
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.todo-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

/* 勾选圆圈 */
.check-circle {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c8d0ca;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.check-circle.checked {
  background-color: #4CAF50;
  border-color: #4CAF50;
}

.check-mark {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}

/* 文字 */
.todo-text {
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.5;
}

/* 已完成状态 */
.todo-item.done .todo-text {
  color: #b5beb8;
  text-decoration: line-through;
}

/* ===== 删除按钮 ===== */
.delete-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-left: 16rpx;
}

.delete-icon {
  font-size: 30rpx;
  color: #d0d5d2;
  font-weight: 300;
}

.delete-btn:active {
  background-color: #fff0f0;
}

.delete-btn:active .delete-icon {
  color: #e57373;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8c9a90;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bcc5bf;
}
